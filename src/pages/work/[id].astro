---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allWork, years, type Work } from '../../lib/data';

export async function getStaticPaths() {
  const work = await allWork();
  // nyl-digital-playslip has its own v2 page.
  const cases = work.filter((w) => w.data.caseStudy && w.id !== 'nyl-digital-playslip').sort((a, b) => (a.data.featured ?? 99) - (b.data.featured ?? 99));
  return cases.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: cases[(i + 1) % cases.length] } }));
}

interface Props { entry: Work; next: Work; }
const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={`${d.client}: ${d.title}`} description={d.summary}>
  {!d.approved && (
    <aside class="review" aria-label="Private review notes">
      <div class="wrap">
        <h2>Private draft. Not approved to publish.</h2>
        <p>Only you can see this. To publish it, set <code>approved: true</code> in this project's file. Until then, this page stays off the live site.</p>
        {d.reviewNotes.length > 0 && <ul>{d.reviewNotes.map((n) => <li>{n}</li>)}</ul>}
      </div>
    </aside>
  )}
  <div class="wrap">
    <header class="case-head">
      <p class="feature-client">{d.client}</p>
      <h1>{d.title}</h1>
      <p>{d.summary}</p>
      <dl class="case-facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Years</dt><dd>{years(entry)}</dd></div>
        <div><dt>At</dt><dd>{d.employer}</dd></div>
        {d.outcome && <div><dt>Result</dt><dd>{d.outcome}</dd></div>}
      </dl>
    </header>
  </div>
  {d.cover && (
    <div class="case-cover">
      <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </div>
  )}
  <article class="prose">
    <Content />
    {next.id !== entry.id && <p class="case-next"><a href={`/work/${next.id}/`}>Next: {next.data.client}</a></p>}
  </article>
</Base>
