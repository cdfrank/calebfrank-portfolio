---
import Base from '../../layouts/Base.astro';
import Job from '../../components/Job.astro';
import { allWork, capabilitiesOf, capabilityMap, groupByClient, logoClass, whereOf } from '../../lib/data';

const work = await allWork();
const groups = groupByClient(work);
const groupOf = new Map(groups.flatMap((g) => g.work.map((w) => [w.id, g])));
const clients = groups.filter((g) => g.id !== 'own-work');
const wall = groups.filter((g) => g.logo);
const first = Math.min(...work.map((w) => w.data.start));

const counted = (values: string[]) => {
  const counts = new Map<string, number>();
  for (const v of values) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts].sort((a, b) => a[0].localeCompare(b[0]));
};
const industries = counted(work.map((w) => w.data.industry));
const places = counted(work.map(whereOf));
const caps = Object.keys(capabilityMap).map((name) => [name, work.filter((w) => capabilitiesOf(w).includes(name)).length] as const);
const PREVIEW = 4;
---
<Base title="All work" description={`${work.length} projects for ${clients.length} clients since ${first}.`}>
  <div class="wrap">
    <header class="page-head compact">
      <h1>Everything, in one list.</h1>
      <p>{work.length} projects for {clients.length} clients since {first}. Pick a logo, or narrow it by what you care about.</p>
    </header>

    <section class="wall" aria-label="Filter by client">
      {wall.map((g) => (
        <button type="button" class="tile" data-client={g.id} aria-pressed="false" aria-label={`${g.name}, ${g.work.length} ${g.work.length === 1 ? 'project' : 'projects'}`}>
          <img class={logoClass(g.logo)} src={`/logos/${g.logo}`} alt="" />
          <span class="tile-count">{g.work.length}</span>
        </button>
      ))}
    </section>

    <form class="tools" data-filters role="search" onsubmit="return false">
      <div class="tools-row">
        <label class="search"><span>Search</span>
          <input type="search" name="q" placeholder="Client, project, or skill" autocomplete="off" />
        </label>
        <label><span>Industry</span>
          <select name="industry"><option value="">All</option>{industries.map(([v, n]) => <option value={v}>{v} ({n})</option>)}</select>
        </label>
        <label><span>Where</span>
          <select name="where"><option value="">All</option>{places.map(([v, n]) => <option value={v}>{v} ({n})</option>)}</select>
        </label>
        <div class="view" role="group" aria-label="Arrange by">
          <span>Arrange by</span>
          <div>
            <button type="button" data-view="client" aria-pressed="true">Client</button>
            <button type="button" data-view="year" aria-pressed="false">Year</button>
          </div>
        </div>
      </div>
      <div class="chips" role="group" aria-label="Filter by kind of work">
        {caps.map(([name, n]) => (
          <button type="button" class="chip" data-cap={name} aria-pressed="false">{name} <span>{n}</span></button>
        ))}
      </div>
    </form>

    <div class="archive-status">
      <span aria-live="polite" data-count>{work.length} projects</span>
      <button type="button" data-clear hidden>Clear filters</button>
    </div>

    <div data-list="client">
      {groups.map((g) => (
        <section class="client" data-client-group={g.id} data-collapsed={g.work.length > PREVIEW ? 'true' : undefined}>
          <header class="client-head">
            <div class="client-mark">
              {g.logo
                ? <img class={logoClass(g.logo)} src={`/logos/${g.logo}`} alt="" loading="lazy" />
                : <span class="logo-text">{g.name}</span>}
            </div>
            <h3 class:list={{ 'sr-only': !g.logo }}>{g.name}</h3>
            <p>{g.span} · {g.work.length} {g.work.length === 1 ? 'project' : 'projects'}</p>
            {g.role && <p>{[g.role, g.where].filter(Boolean).join(', ')}</p>}
            {g.brands.length > 0 && (
              <div class="client-brands">
                {g.brands.map((b) => <img class={logoClass(b)} src={`/logos/${b}`} alt="" loading="lazy" />)}
              </div>
            )}
          </header>
          <div class="client-work">
            <ul>
              {g.work.map((w) => <Job work={w} group={g} />)}
            </ul>
            {g.work.length > PREVIEW && (
              <button type="button" class="show-more" data-more={g.work.length - PREVIEW} aria-expanded="false" hidden>Show {g.work.length - PREVIEW} more</button>
            )}
          </div>
        </section>
      ))}
    </div>

    <ul class="by-year" data-list="year" hidden>
      {work.map((w) => <Job work={w} group={groupOf.get(w.id)!} compact />)}
    </ul>

    <p class="empty" data-empty hidden>Nothing matches those filters. Try clearing one.</p>
  </div>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const jobs = [...document.querySelectorAll<HTMLElement>('.job')];
  const sections = [...document.querySelectorAll<HTMLElement>('.client')];
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.tile')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const views = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const listClient = document.querySelector<HTMLElement>('[data-list="client"]')!;
  const listYear = document.querySelector<HTMLElement>('[data-list="year"]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const PREVIEW = 4;

  const params = new URLSearchParams(location.search);
  const state = {
    client: params.get('client') ?? '',
    cap: params.get('cap') ?? '',
    year: params.get('year') ?? '',
    view: params.get('view') ?? (params.get('year') ? 'year' : 'client'),
  };
  for (const name of ['q', 'industry', 'where']) {
    const field = form.elements.namedItem(name) as HTMLInputElement | null;
    const value = params.get(name);
    if (field && value) field.value = value;
  }

  function apply() {
    const data = new FormData(form);
    const q = String(data.get('q') ?? '').trim().toLowerCase();
    const industry = String(data.get('industry') ?? '');
    const where = String(data.get('where') ?? '');
    const filtering = Boolean(q || industry || where || state.client || state.cap || state.year);

    let shown = 0;
    for (const j of jobs) {
      const match =
        (!q || j.dataset.search!.includes(q)) &&
        (!industry || j.dataset.industry === industry) &&
        (!where || j.dataset.where === where) &&
        (!state.client || j.dataset.group === state.client) &&
        (!state.cap || j.dataset.caps!.split('|').includes(state.cap)) &&
        (!state.year || j.dataset.start === state.year);
      j.hidden = !match;
      if (match && j.closest('[data-list="client"]')) shown++;
    }

    for (const s of sections) {
      const rows = [...s.querySelectorAll<HTMLElement>('.job')];
      const visible = rows.filter((r) => !r.hidden);
      s.hidden = visible.length === 0;
      const more = s.querySelector<HTMLButtonElement>('.show-more');
      const open = more?.getAttribute('aria-expanded') === 'true';
      const collapse = Boolean(more) && !filtering && !open;
      if (collapse) rows.slice(PREVIEW).forEach((r) => (r.hidden = true));
      if (more) more.hidden = filtering;
    }

    listClient.hidden = state.view !== 'client';
    listYear.hidden = state.view !== 'year';
    views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === state.view)));
    tiles.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.client === state.client)));
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cap === state.cap)));
    document.querySelector('.wall')!.classList.toggle('has-pick', Boolean(state.client));

    count.textContent = `${shown} ${shown === 1 ? 'project' : 'projects'}${state.year ? ` started in ${state.year}` : ''}`;
    empty.hidden = shown > 0;
    clear.hidden = !filtering;

    const url = new URLSearchParams();
    if (q) url.set('q', q);
    if (industry) url.set('industry', industry);
    if (where) url.set('where', where);
    if (state.client) url.set('client', state.client);
    if (state.cap) url.set('cap', state.cap);
    if (state.year) url.set('year', state.year);
    if (state.view !== 'client') url.set('view', state.view);
    history.replaceState(null, '', url.size ? `?${url}` : location.pathname);
  }

  form.addEventListener('input', apply);
  tiles.forEach((t) => t.addEventListener('click', () => {
    state.client = state.client === t.dataset.client ? '' : t.dataset.client!;
    apply();
  }));
  chips.forEach((c) => c.addEventListener('click', () => {
    state.cap = state.cap === c.dataset.cap ? '' : c.dataset.cap!;
    apply();
  }));
  views.forEach((b) => b.addEventListener('click', () => { state.view = b.dataset.view!; apply(); }));
  document.querySelectorAll<HTMLButtonElement>('.show-more').forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    b.textContent = open ? `Show ${b.dataset.more} more` : 'Show fewer';
    apply();
  }));
  clear.addEventListener('click', () => {
    form.reset();
    state.client = state.cap = state.year = '';
    apply();
  });
  apply();
</script>
