---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <div class="wrap">
    <header class="page-head">
      <h1>Nothing here.</h1>
      <p>That page moved or never existed. The work is still easy to find.</p>
    </header>
    <div class="actions">
      <a class="btn solid" href="/">Go to the homepage</a>
      <a class="btn" href="/work/">Browse everything</a>
    </div>
  </div>
</Base>
