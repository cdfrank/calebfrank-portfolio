---
// Direction test: today's coded loops beside the lit 3D loops, for two projects. Not linked from the site.
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../../styles/v2/loops.css';
import '../../styles/v2/lit-loops.css';

const rows = [
  { slug: 'self-initiated-street-signal', title: 'Street Signal', note: 'Scan a real ledge with the phone (its screen is a live camera view of the set), lock the spot, then skate it: grind in sparks, kickflip out, crane up to the spot map.' },
  { slug: 'nyl-digital-playslip', title: 'New York Lottery Digital Playslip', note: 'A pencil marks the real Quick Draw slip, the slip breaks into its own colored flecks that stream into the phone, the four steps run with a live total, and the counter scanner reads the QR and prints the ticket.' },
  { slug: 'basf-salesx', title: 'BASF SalesX', note: 'A worktable at the edge of a cornfield at golden hour. Five scattered tools lift off the table and fly into one tablet as its modules, the tablet stands up and runs the season plan: growers on the map, season bars, 40 to 800+ sales pros.' },
  { slug: 'general-motors-build-price-platform-redesign', title: 'GM Build and Price', note: '212 option chips swirl over an empty showroom, sort into car, SUV and truck, SUV is picked and scanned onto the turntable, then one builder runs model, trim, color and price across every brand, ending on a low hero shot.' },
  { slug: 'honeywell-product-selector-and-tools', title: 'Honeywell product selector', note: 'A ball valve drops onto a lit turntable like a new sneaker. Four plain questions narrow 214 parts to 1; the trim question cuts the valve away to show the ball glowing blue, then the match card pops and the handle turns.' },
  { slug: 'new-york-lottery-single-sign-on', title: 'New York Lottery single sign-on', note: 'Four doors, four keypads, each refusing its own password. Gold light gathers into one key that visits every keypad, all four doors swing open, and the camera pulls back to one line: 1 account, 4 experiences.' },
  { slug: 'basf-agriculture-customer-portal', title: 'BASF Customer Portal', note: "A white architect's model of the supply chain: crates hop BASF to partner to farm, a Partner Portal rises and links them, then one sign-in opens the Customer Portal straight to the farm." },
  { slug: 'valero-digital-ecosystem-audit', title: 'Valero digital ecosystem audit', note: 'A fuel-station forecourt at blue hour: map every touchpoint, ask the people who use them, sort 100 ideas by effort and value, and keep the five that make a minimum viable site.' },
  { slug: 'city-of-raleigh-website-redesign', title: 'City of Raleigh website', note: 'A miniature city at blue hour. The old site spews 7,713 pages over the skyline, one lead and a remote team rebuild it around "How Do I?" tasks, and residents check off their errands.' },
  { slug: 'general-motors-global-design-system', title: 'GM global design system', note: 'Three brands, three different Shop now buttons. Each sheds its radius, spacing, type and color into shared tokens, one grid lays across all three, and each brand keeps its voice.' },
  { slug: 'general-motors-onstar-shopping-pages-and-cart', title: 'OnStar shopping pages and cart', note: 'A badge flips from supporting role to lead designer, 18+ page screens rise out of a model city, a plan drops into the cart, and the city lights up with the new weekly views.' },
  { slug: 'gm-lab313-mycardrive', title: 'Lab313 MyCarDrive', note: 'A research room in morning light: 13 hypotheses pin to the board and get stamped, seven hold and six fall, and red string runs from every miss to one card: trust.' },
  { slug: 'gm-lab313-test-drive-myway', title: 'Lab313 Test Drive MyWay', note: 'A sunny street: the phone books Saturday 10 AM, folds into a pin, a route draws to the dealer, and the Bolt EV drives it to the curb.' },
  { slug: 'mrm-agent-relationship-management', title: 'MRM agent relationship management', note: "A warm studio of brand pillars and clay figures. The customer's AI agent is born, scans three brands, locks onto one, and the console rises with its apps." },
  { slug: 'mrm-ux-team-ux-jam-sessions', title: 'MRM UX Jam sessions', note: 'A studio at night: one lamp over the first jam in 2019, the format keeps changing as lamps light down the table, Figma 101 to 301 rise as steps, and the team grows to 2025.' },
  { slug: 'stella-alert-rework', title: 'STELLA alert rework', note: 'A service drive at night: after the call, follow-up cards burst out all alike, one takes the new strip, tile and button layout, and the queue sorts itself by urgency.' },
  { slug: 'self-initiated-tin-minnows-bearings-co', title: 'Tin Minnows Bearings Co.', note: 'A bait-shop counter: a key rolls back the lid of a fish tin to show the bearings, one slides onto a wheel and clicks home, and the wheel spins up.' },
  { slug: 'honeywell-building-automation-site-proposal', title: 'Honeywell building automation proposal', note: "An architect's studio at night: each phase drops in as a floor of the building (site map, dashboards, API marketplace, mobile commerce), then the whole plan lights up." },
  { slug: 'jayco-product-experience-proposal', title: 'Jayco product experience proposal', note: 'A trailer in a pine clearing at blue hour: hotspots on the product detail, the roof lifts for the configurator, a dealer map spreads on the ground, and the prototype rises on a phone.' },
  { slug: 'self-initiated-shred-dice', title: 'Shred & Dice', note: 'Game night over a printed city map: each dice roll sends the deck into a trick, a kickflip, a boardslide, then doubles flare into a tre flip.' },
  { slug: 'new-york-lottery-live-drawing-and-integrity-pages', title: 'Lottery live drawing and integrity pages', note: 'A broadcast studio: the drawing machine sends five balls to the results wall, a sweep checks each number, and a gold shield seals fair play and responsible gaming.' },
  { slug: 'self-initiated-playable-figma-make-games', title: 'Playable Figma Make games', note: 'One Figma frame on a dot-grid canvas: Play is clicked, the flat layers spring into a 3D level, and the board skates through it while the five game titles cycle.' },
  { slug: 'olympia-skate-shop-brand-web-and-nike-materials', title: 'Olympia Skate Shop and Nike SB', note: 'A rainy night at the shop: the crew deals its pitch cards, the 3D logo rises and the account is won, the sign lights up and the shoeboxes fly off the counter.' },
  { slug: 'self-initiated-tart', title: 'TART', note: 'A giving gateway: card, bank and coin fly through one ring and come out as hearts that fill three jars, traditional and Web3 payments alike.' },
  { slug: 'self-initiated-design-system-scanner', title: 'Design System Scanner', note: 'A scanner sweeps a web page and pulls its colors, type and buttons into a specimen tray, flags two button styles, and fixes them back to one.' },
  { slug: 'self-initiated-portfolios-please', title: 'Portfolios Please', note: 'An inspection booth on a rainy day: portfolios slide through the slot, one gets HIRED, the next gets DENIED, and the sign lights up.' },
  { slug: 'corebridge-financial-new-business-story', title: "Corebridge new business story", note: "A pitch room: the BASF story arc draws across four panels, then the panels flip to finance and the arc redraws in blue." },
  { slug: 'new-york-lottery-alexa-skills-and-help-center', title: "NY Lottery Alexa and help center", note: "A smart speaker on a night table wakes, opens a floating help center, and speaks the answer back." },
  { slug: 'mcdonald-s-crm-pitch', title: "McDonald's CRM pitch", note: "A lacquer turntable runs the loyalty loop: app, order, reward, return, faster each lap." },
  { slug: 'fujifilm-instax-instax-north-america-website', title: "Instax North America site", note: "An instant camera fires, the print develops in the air and flies into the phone's gallery." },
  { slug: 'self-initiated-indoor-skatepark-proposal', title: "Indoor skatepark proposal", note: "A snowy warehouse lights up, the door rolls open and a mini-ramp session runs all year." },
  { slug: 'us-marine-corps-marine-corps-pitch', title: "Marine Corps pitch", note: "A sand-table briefing: markers rise, a gold route draws and travelers run it to the finish." },
  { slug: 'mrm-ai-and-asset-management-vision', title: "MRM AI and asset management", note: "A hero tile leaves the asset wall, ignites the AI core and fills three personalized ad slots." },
  { slug: 'optum-experience-design-support', title: "Optum experience design support", note: "Morning light on a brief: highlights, sticky notes, then three phone concepts drop into the dock." },
  { slug: 'fujifilm-direct-to-consumer-platform', title: "Fujifilm direct-to-consumer", note: "A film box ships in a kraft mailer and a print rises out of it, developing into a lake." },
  { slug: 'fujifilm-amazon-experience-review', title: "Fujifilm Amazon review", note: "A loupe audits an Amazon listing; each finding flies to the audit card, which gets stamped." },
  { slug: 'new-york-lottery-crm-overhaul', title: "NY Lottery CRM overhaul", note: "Preferences slide on, a newsletter builds, seals in an envelope and rides the journey track." },
  { slug: 'astrazeneca-farxiga-landing-pages', title: "Farxiga landing pages", note: "Window light in a gallery: the page scrolls under a pinned panel and review seals drop into a brass rail." },
  { slug: 'thomas-edison-center-thomas-edison-center-website', title: "Thomas Edison Center site", note: "An Edison bulb flickers on, the site lights up and three service cards land on a ledge." },
  { slug: 'new-york-lottery-quick-draw-rebrand', title: "Quick Draw rebrand", note: "Research bubbles, sketches on a light table, one becomes the glossy mark over the number grid." },
  { slug: 'honeywell-cart-and-checkout', title: "Honeywell cart and checkout", note: "Parts hop into the tote, a quick-cart paste rains 45 cartons, checkout fills and the dock opens." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lit loops, direction test | Caleb Frank</title>
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; background: #0b0b0c; color: #f2efe8; font: 400 16px/1.5 Inter, system-ui, sans-serif; }
      main { max-width: 1240px; margin: 0 auto; padding: 40px 16px 80px; }
      h1 { font-size: clamp(28px, 4vw, 44px); line-height: 1.05; margin: 0 0 10px; letter-spacing: -0.02em; }
      .lede { color: #b9b4aa; max-width: 70ch; margin: 0 0 8px; }
      .lede b { color: #d7ff3a; font-weight: 600; }
      section { margin-top: 48px; }
      h2 { font-size: 22px; margin: 0 0 4px; }
      .note { color: #9a958c; margin: 0 0 18px; max-width: 80ch; font-size: 15px; }
      .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      @media (max-width: 760px) { .pair { grid-template-columns: 1fr; } }
      figure { margin: 0; }
      figcaption { display: flex; justify-content: space-between; font: 700 12px/1 "JetBrains Mono", ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; color: #8d887f; margin: 0 0 8px; }
      figcaption b { color: #d7ff3a; }
      .box { border-radius: 8px; overflow: hidden; }
      .box svg.hl { border-radius: 8px; }
      .how { margin-top: 56px; border-top: 1px solid #2a2a2c; padding-top: 24px; color: #b9b4aa; max-width: 80ch; font-size: 15px; }
      .how a { color: #d7ff3a; }
    </style>
  </head>
  <body>
    <main>
      <h1>Lit loops: a direction test</h1>
      <p class="lede">Left is today's coded loop. Right is the same story as a <b>lit 3D set</b>: real light and materials, a moving camera, impacts and particles. The lit loop plays when its row is on screen.</p>
      {rows.map((r) => (
        <section>
          <h2>{r.title}</h2>
          <p class="note">{r.note}</p>
          <div class="pair">
            <figure><figcaption><span>Today</span><span>coded SVG</span></figcaption><div class="box" data-classic={r.slug}></div></figure>
            <figure><figcaption><b>Lit</b><span>real-time 3D</span></figcaption><div class="box" data-lit={r.slug}></div></figure>
          </div>
        </section>
      ))}
      <p class="how">In place on the site: the same two projects play the lit version in the Home record card, the Work page hover card and the phone viewer on this preview. Every other project still plays its coded loop. Add <code>?loops=classic</code> to any page to switch the lit loops off.</p>
      <pre id="dbg" hidden style="white-space:pre-wrap;font:12px/1.4 monospace;color:#f88;margin-top:24px"></pre>
    </main>
    <script>
      import { enhance } from '../../components/v2/loop3d/hook.js';
      if (location.search.includes('debug')) {
        const d = document.getElementById('dbg')!;
        d.hidden = false;
        addEventListener('error', (e) => ((window as any).__l3dErrors ||= []).push('err: ' + e.message));
        addEventListener('unhandledrejection', (e) => ((window as any).__l3dErrors ||= []).push('rej: ' + String(e.reason && (e.reason.stack || e.reason))));
        setInterval(() => { d.textContent = 'debug ' + performance.now().toFixed(0) + '\n' + ((window as any).__l3dErrors || []).join('\n---\n'); }, 500);
      }
      const sheet = new URLSearchParams(location.search).get('sheet');
      if (sheet) {
        // Contact sheet: one loop rendered at fixed times, for reviewing framing and light frame by frame.
        const from = parseFloat(new URLSearchParams(location.search).get('from') || '0');
        const step = parseFloat(new URLSearchParams(location.search).get('step') || '0.5');
        const n = parseInt(new URLSearchParams(location.search).get('n') || '20');
        document.querySelector('main')!.innerHTML = '<div id="sh" style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px"></div>';
        const sh = document.getElementById('sh')!;
        import('../../components/v2/loop3d/runtime.js').then(async (rt) => {
          for (let i = 0; i < n; i++) {
            const t = from + i * step;
            const url = await rt.still(sheet, t);
            sh.insertAdjacentHTML('beforeend', `<figure style="margin:0"><img src="${url}" style="width:100%;display:block"><figcaption style="font:11px monospace;color:#999">${t.toFixed(2)}s</figcaption></figure>`);
          }
        });
      }
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const svgFor = (slug) => fetch(`/loops/${slug}.svg`).then((r) => (r.ok ? r.text() : ''));
      const start = (box) => {
        const svg = box.querySelector('svg.hl');
        if (!svg || !svg.getAnimations) return svg;
        svg.removeAttribute('role');
        svg.classList.add('hl-js');
        const t = parseFloat(svg.dataset.poster || '5') * 1000;
        svg.getAnimations({ subtree: true }).forEach((a) => { a.currentTime = still ? t : 0; if (still) a.pause(); else a.play(); });
        return svg;
      };
      if (!sheet) document.querySelectorAll<HTMLElement>('[data-classic]').forEach((box) => {
        svgFor(box.dataset.classic!).then((m) => { box.innerHTML = m; start(box); });
      });
      const lits: { box: HTMLElement; ctl: ReturnType<typeof enhance>; ratio: number }[] = [];
      let current: (typeof lits)[number] | null = null;
      const pick = () => {
        const best = lits.reduce<(typeof lits)[number] | null>((a, b) => (b.ratio > (a ? a.ratio : 0.35) ? b : a), null);
        if (best === current) return;
        if (current && current.ctl) current.ctl.rest();
        current = best;
        if (current && current.ctl) current.ctl.play();
      };
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { const l = lits.find((x) => x.box === e.target); if (l) l.ratio = e.intersectionRatio; });
        pick();
      }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
      if (!sheet) document.querySelectorAll<HTMLElement>('[data-lit]').forEach((box) => {
        const slug = box.dataset.lit!;
        svgFor(slug).then((m) => {
          box.innerHTML = m;
          start(box);
          const ctl = enhance(box, slug);
          lits.push({ box, ctl, ratio: 0 });
          io.observe(box);
        });
      });
    </script>
  </body>
</html>
