---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allWork, years, type Work } from '../../lib/data';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../../styles/v2/loops.css';

export async function getStaticPaths() {
  const work = await allWork();
  // nyl-digital-playslip has its own v2 page.
  const cases = work.filter((w) => w.data.caseStudy && w.id !== 'nyl-digital-playslip').sort((a, b) => (a.data.featured ?? 99) - (b.data.featured ?? 99));
  return cases.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: cases[(i + 1) % cases.length] } }));
}

interface Props { entry: Work; next: Work; }
const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
// No cover yet: the project's coded loop stands in, playing on its own (still frame for reduced motion).
const loopFile = join(process.cwd(), 'public', 'loops', `${entry.id}.svg`);
const loop = !d.cover && existsSync(loopFile) ? readFileSync(loopFile, 'utf8') : '';
---
<Base title={`${d.client}: ${d.title}`} description={d.summary}>
  {!d.approved && (
    <aside class="review" aria-label="Private review notes">
      <div class="wrap">
        <h2>Private draft. Not approved to publish.</h2>
        <p>Only you can see this. To publish it, set <code>approved: true</code> in this project's file. Until then, this page stays off the live site.</p>
        {d.reviewNotes.length > 0 && <ul>{d.reviewNotes.map((n) => <li>{n}</li>)}</ul>}
      </div>
    </aside>
  )}
  <div class="wrap">
    <header class="case-head">
      <p class="feature-client">{d.client}</p>
      <h1>{d.title}</h1>
      <p>{d.summary}</p>
      <dl class="case-facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Years</dt><dd>{years(entry)}</dd></div>
        <div><dt>At</dt><dd>{d.employer}</dd></div>
        {d.outcome && <div><dt>Result</dt><dd>{d.outcome}</dd></div>}
      </dl>
    </header>
  </div>
  {d.cover && (
    <div class="case-cover">
      <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </div>
  )}
  {loop && <div class="case-cover case-loop" data-c3d={entry.id} set:html={loop} />}
  <article class="prose">
    <Content />
    {next.id !== entry.id && <p class="case-next"><a href={`/work/${next.id}/`}>Next: {next.data.client}</a></p>}
  </article>
</Base>

<script>
  // Case studies with a 3D scene: swap the coded loop for the WebGL stage. The loop stays as the
  // fallback for reduced motion, no WebGL, or any failure while loading.
  const host = document.querySelector<HTMLElement>('[data-c3d]');
  if (host && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    import('../../components/v2/case3d/index.js').then(({ createPlayer, webglOK, scenes }) => {
      const slug = host.dataset.c3d || '';
      if (!webglOK() || !scenes[slug]) return;
      const stage = document.createElement('div');
      try {
        host.appendChild(stage);
        createPlayer(stage, scenes).load(slug);
        host.querySelector('svg.hl')?.remove();
      } catch (e) { stage.remove(); }
    }).catch(() => {});
  }
</script>
