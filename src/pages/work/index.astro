---
import V2 from '../../layouts/V2.astro';
import Work from '../../components/v2/Work.jsx';
import { allWork } from '../../lib/data';
import { clientRecord } from '../../lib/record';
import '../../styles/v2/Work.css';

const rec = clientRecord(await allWork());
---
<V2 title="All work" description={`${rec.W.length} projects for ${rec.clients} clients since ${rec.first}.`}>
  <Work client:load rec={rec} />
</V2>
